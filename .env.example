# Discord Integration (Webhook)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Database (optional - defaults to SQLite)
DATABASE_URL=sqlite:///data/mango_scraper.db

# Scraper Settings (Smart scheduling handles intervals)
HEADLESS_BROWSER=true

# Confidence Thresholds (higher = fewer but better signals)
MIN_CONFIDENCE_SWING=60
MIN_CONFIDENCE_SCALP=75

# Streamlit
STREAMLIT_SERVER_PORT=8501

# TradingView Layout (Optional)
# Set your layout ID here if scraping incorrect charts
# TRADINGVIEW_LAYOUT_ID=your_layout_id
# You can also set specific layouts for timeframes:
# TRADINGVIEW_LAYOUT_4H=layout_id_4h
# TRADINGVIEW_LAYOUT_1H=layout_id_1h
# TRADINGVIEW_LAYOUT_30M=layout_id_30m
# TRADINGVIEW_LAYOUT_15M=layout_id_15m
# TRADINGVIEW_LAYOUT_5M=layout_id_5m
# TRADINGVIEW_LAYOUT_3M=layout_id_3m
